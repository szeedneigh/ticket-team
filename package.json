{
  "name": "ticket-team",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/pre-dev-check.ts && cross-env NODE_OPTIONS=\"--no-deprecation\" next dev",
    "dev:clean": "npm run clean:cache && npm run dev",
    "dev:safe": "npm run clean:cache && npm run check-db && cross-env NODE_OPTIONS=\"--no-deprecation\" next dev",
    "dev:unsafe": "cross-env NODE_OPTIONS=\"--no-deprecation\" next dev",
    "build": "next build",
    "build:clean": "npm run clean:cache && npm run build",
    "prebuild": "tsx scripts/check-build-health.ts || echo 'Build health check failed, continuing...'",
    "start": "next start",
    "lint": "eslint",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "playwright:install": "playwright install chromium",
    "clean": "rm -rf .next node_modules/.cache",
    "clean:cache": "tsx scripts/clean-cache.ts",
    "check-db": "tsx scripts/check-db.ts",
    "check-env": "node scripts/check-env.js",
    "health": "tsx scripts/check-build-health.ts",
    "check-bundle-security": "tsx scripts/check-client-bundle-security.ts",
    "postbuild": "npm run check-bundle-security"
  },

{
  "name": "ticket-team",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.sass",
    "./src/instrumentation.ts",
    "./instrumentation.ts"
  ],
  "scripts": {
    "dev": "tsx scripts/pre-dev-check.ts && cross-env NODE_OPTIONS=\"--no-deprecation\" next dev",
    "dev:clean": "npm run clean:cache && npm run dev",
    "dev:safe": "npm run clean:cache && npm run check-db && cross-env NODE_OPTIONS=\"--no-deprecation\" next dev",
    "dev:unsafe": "cross-env NODE_OPTIONS=\"--no-deprecation\" next dev",
    "build": "next build",
    "build:clean": "npm run clean:cache && npm run build",
    "prebuild": "tsx scripts/check-build-health.ts || echo 'Build health check failed, continuing...'",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "playwright:install": "playwright install chromium firefox webkit",
    "clean": "rm -rf .next node_modules/.cache",
    "clean:cache": "tsx scripts/clean-cache.ts",
    "check-db": "tsx scripts/check-db.ts",
    "check-env": "node scripts/check-env.js",
    "health": "tsx scripts/check-build-health.ts",
    "check-bundle-security": "tsx scripts/check-client-bundle-security.ts",
    "postbuild": "npm run check-bundle-security",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.29.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^1.0.1",
    "@react-email/render": "^2.0.0",
    "@sentry/nextjs": "^10.22.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.75.0",
    "@tiptap/extension-code-block-lowlight": "^3.10.3",
    "@tiptap/extension-image": "^3.10.3",
    "@tiptap/extension-link": "^3.10.3",
    "@tiptap/pm": "^3.10.3",
    "@tiptap/react": "^3.10.3",
    "@tiptap/starter-kit": "^3.10.3",
    "@types/dompurify": "^3.0.5",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.0",
    "framer-motion": "^12.23.24",
    "jsdom": "^26.1.0",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "lightningcss": "^1.30.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.545.0",
    "next": "^16.1.6",
    "next-nprogress-bar": "^2.4.7",
    "next-themes": "^0.4.6",
    "node-html-parser": "^7.0.1",
    "papaparse": "^5.5.3",
    "react": "19.1.0",
    "react-day-picker": "^9.11.1",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.66.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.14.1",
    "recharts": "^3.3.0",
    "rehype-highlight": "^7.0.2",
    "resend": "^6.5.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "ua-parser-js": "^2.0.6",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^16.0.3",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.19.24",
    "@types/papaparse": "^5.5.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ua-parser-js": "^0.7.39",
    "@vitest/ui": "^4.0.9",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.7",
    "happy-dom": "^20.0.10",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "shadcn": "^3.5.0",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0"
    ]
  },
  "overrides": {
    "react-is": "^19.0.0-rc-69d4b800-20241021"
  }
}

# Testing & Quality Assurance

## Testing Strategy

### Test Pyramid
1. **Unit Tests** (most): Test individual functions and components
2. **Integration Tests** (moderate): Test feature workflows
3. **E2E Tests** (few): Test critical user journeys

### What to Test
- Business logic and data transformations
- API routes and Server Actions
- Database operations and RLS policies
- Component rendering and user interactions
- Error handling and edge cases
- Authentication and authorization flows

### What NOT to Test
- Third-party libraries (trust them)
- Framework internals (Next.js, React)
- Trivial getters/setters
- Pure UI styling (use visual regression instead)

## Testing Tools

- **Unit/Integration**: Jest + React Testing Library
- **E2E**: Playwright or Cypress
- **API**: Supertest or Vitest
- **Database**: Supabase test project or pg-mem
- **Mocking**: MSW (Mock Service Worker) for API mocking

## Unit Testing

### Component Tests

```tsx
// components/tickets/TicketCard.test.tsx
import { render, screen } from '@testing-library/react'
import { TicketCard } from './TicketCard'

describe('TicketCard', () => {
  const mockTicket = {
    id: '123',
    title: 'Test Ticket',
    status: 'open',
    priority: 'high'
  }
  
  it('renders ticket title', () => {
    render(<TicketCard ticket={mockTicket} />)
    expect(screen.getByText('Test Ticket')).toBeInTheDocument()
  })
  
  it('displays high priority badge', () => {
    render(<TicketCard ticket={mockTicket} />)
    expect(screen.getByText('High')).toHaveClass('badge-urgent')
  })
})
```

### Utility Function Tests

```ts
// lib/utils/formatDate.test.ts
import { formatDate } from './formatDate'

describe('formatDate', () => {
  it('formats ISO string to readable date', () => {
    const input = '2025-01-15T10:30:00Z'
    expect(formatDate(input)).toBe('Jan 15, 2025')
  })
  
  it('handles invalid dates gracefully', () => {
    expect(formatDate('invalid')).toBe('Invalid Date')
  })
})
```

## Integration Testing

### Server Actions

```ts
// app/actions/tickets.test.ts
import { createTicket } from './tickets'
import { createMockSupabaseClient } from '@/test/utils'

jest.mock('@/lib/supabase/server', () => ({
  createClient: () => createMockSupabaseClient()
}))

describe('createTicket', () => {
  it('creates ticket with valid data', async () => {
    const formData = new FormData()
    formData.append('title', 'Test Ticket')
    formData.append('description', 'Test description')
    
    const result = await createTicket(formData)
    
    expect(result.success).toBe(true)
    expect(result.data.title).toBe('Test Ticket')
  })
  
  it('validates required fields', async () => {
    const formData = new FormData()
    formData.append('title', 'Too short') // Below minimum length
    
    const result = await createTicket(formData)
    
    expect(result.success).toBe(false)
    expect(result.error).toContain('minimum')
  })
})
```

### API Routes

```ts
// app/api/tickets/route.test.ts
import { GET } from './route'
import { NextRequest } from 'next/server'

describe('GET /api/tickets', () => {
  it('returns tickets for authenticated user', async () => {
    const request = new NextRequest('http://localhost:3000/api/tickets')
    const response = await GET(request)
    const data = await response.json()
    
    expect(response.status).toBe(200)
    expect(Array.isArray(data)).toBe(true)
  })
  
  it('returns 401 for unauthenticated requests', async () => {
    // Mock unauthenticated state
    const request = new NextRequest('http://localhost:3000/api/tickets')
    const response = await GET(request)
    
    expect(response.status).toBe(401)
  })
})
```

## E2E Testing

### Critical User Journeys

```ts
// e2e/ticket-creation.spec.ts
import { test, expect } from '@playwright/test'

test.describe('Ticket Creation Flow', () => {
  test.beforeEach(async ({ page }) => {
    // Login as employee
    await page.goto('/login')
    await page.fill('[name="email"]', 'employee@test.com')
    await page.fill('[name="password"]', 'password123')
    await page.click('button[type="submit"]')
  })
  
  test('employee can create a new ticket', async ({ page }) => {
    await page.goto('/tickets/new')
    
    // Fill form
    await page.fill('[name="title"]', 'Printer not working')
    await page.fill('[name="description"]', 'Office printer is offline')
    await page.selectOption('[name="category"]', 'technical')
    await page.selectOption('[name="priority"]', 'medium')
    
    // Submit
    await page.click('button:has-text("Create Ticket")')
    
    // Verify success
    await expect(page).toHaveURL(/\/tickets\/\w+/)
    await expect(page.locator('h1')).toContainText('Printer not working')
  })
  
  test('validates required fields', async ({ page }) => {
    await page.goto('/tickets/new')
    
    // Try to submit without filling
    await page.click('button:has-text("Create Ticket")')
    
    // Verify validation errors
    await expect(page.locator('text=Title is required')).toBeVisible()
  })
})
```

## Database Testing

### RLS Policy Tests

```sql
-- test/rls/tickets.test.sql
BEGIN;
SELECT plan(3);

-- Test: Employee can read own tickets
SET LOCAL ROLE employee;
SET LOCAL "request.jwt.claims" = '{"sub":"employee-user-id"}';

SELECT results_eq(
  'SELECT id FROM tickets WHERE created_by = ''employee-user-id''',
  ARRAY['ticket-1', 'ticket-2'],
  'Employee can read own tickets'
);

-- Test: Employee cannot read other tickets
SELECT is_empty(
  'SELECT id FROM tickets WHERE created_by != ''employee-user-id''',
  'Employee cannot read other user tickets'
);

-- Test: MIS staff can read all tickets
SET LOCAL ROLE mis_staff;
SELECT cmp_ok(
  (SELECT COUNT(*) FROM tickets),
  '>',
  0,
  'MIS staff can read all tickets'
);

SELECT * FROM finish();
ROLLBACK;
```

## Mocking

### Mock Supabase Client

```ts
// test/utils/mockSupabase.ts
export function createMockSupabaseClient() {
  return {
    from: jest.fn(() => ({
      select: jest.fn().mockReturnThis(),
      insert: jest.fn().mockReturnThis(),
      update: jest.fn().mockReturnThis(),
      delete: jest.fn().mockReturnThis(),
      eq: jest.fn().mockReturnThis(),
      single: jest.fn().mockResolvedValue({ data: mockData, error: null })
    })),
    auth: {
      getUser: jest.fn().mockResolvedValue({ data: { user: mockUser }, error: null })
    }
  }
}
```

### Mock AI Responses

```ts
// test/utils/mockGemini.ts
export function mockGeminiResponse(text: string) {
  return {
    generateContent: jest.fn().mockResolvedValue({
      response: {
        text: () => text
      }
    })
  }
}
```

## Quality Gates

### Pre-commit Hooks
Use Husky or Lefthook to run checks before commits:
- Lint with ESLint
- Format with Prettier
- Run unit tests
- Type check with TypeScript

```json
// .husky/pre-commit
npm run lint
npm run type-check
npm run test:unit
```

### CI/CD Pipeline
Run in GitHub Actions or similar:
1. Install dependencies
2. Lint and type check
3. Run all tests (unit, integration, E2E)
4. Build application
5. Deploy (if all pass)

```yaml
# .github/workflows/test.yml
name: Test
on: [push, pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - uses: actions/setup-node@v3
      - run: npm ci
      - run: npm run lint
      - run: npm run type-check
      - run: npm run test:unit
      - run: npm run test:e2e
```

### Code Coverage
- Target: 80%+ coverage for critical paths
- Use `jest --coverage` to generate reports
- Track coverage over time

## Accessibility Testing

- Use `@axe-core/playwright` or `jest-axe`
- Test keyboard navigation
- Verify ARIA labels
- Check color contrast

```ts
import { test, expect } from '@playwright/test'
import AxeBuilder from '@axe-core/playwright'

test('ticket form is accessible', async ({ page }) => {
  await page.goto('/tickets/new')
  
  const accessibilityScanResults = await new AxeBuilder({ page })
    .analyze()
  
  expect(accessibilityScanResults.violations).toEqual([])
})
```

## Performance Testing

- Use Lighthouse CI for performance budgets
- Test load time under various network conditions
- Monitor bundle size in CI

